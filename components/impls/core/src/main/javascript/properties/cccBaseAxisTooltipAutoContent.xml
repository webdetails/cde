<DesignerProperty>
  <Header>
    <Name>cccBaseAxisTooltipAutoContent</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>value</DefaultValue>
    <Description>Base Axis Tooltip Auto Content</Description>
    <Tooltip>Indicates the type of automatic content generated for the tooltip of axis' labels (applies to discrete axes).</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>255</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="Summary">summary</Value>
    <Value display="Value">value</Value>
  </Values>
</DesignerProperty>
