<DesignerProperty>
  <Header>
    <Name>cccDataIgnoreMetadataLabels</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>false</DefaultValue>
    <Description>Data Ignore Metadata Labels</Description>
    <Tooltip>Indicates if the data source translation should ignore the column labels present in the data source's metadata as defaults for the labels of dimensions that are directly loaded from those columns.</Tooltip>
    <InputType>Boolean</InputType>
    <OutputType>Boolean</OutputType>
    <Order>305</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
</DesignerProperty>
