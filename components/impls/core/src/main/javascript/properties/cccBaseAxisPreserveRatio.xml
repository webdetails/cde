<DesignerProperty>
  <Header>
    <Name>cccBaseAxisPreserveRatio</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue></DefaultValue>
    <Description>Base Axis Preserve Ratio</Description>
    <Tooltip>Indicates if the initial proportion between the axis' domain and range lengths should be preserved between renders (applies to continuous axes).</Tooltip>
    <InputType>Boolean</InputType>
    <OutputType>Boolean</OutputType>
    <Order>236</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
</DesignerProperty>
