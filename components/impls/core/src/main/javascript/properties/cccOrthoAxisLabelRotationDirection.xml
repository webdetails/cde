<DesignerProperty>
  <Header>
    <Name>cccOrthoAxisLabelRotationDirection</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>clockwise</DefaultValue>
    <Description>Ortho Axis Label Rotation Direction</Description>
    <Tooltip>Controls the rotation direction of the labels (applies to normal discrete axes).</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>421</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="Clockwise">clockwise</Value>
    <Value display="Counterclockwise">counterclockwise</Value>
  </Values>
</DesignerProperty>
