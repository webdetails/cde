<DesignerProperty>
  <Header>
    <Name>cccValuesOverflow</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>hide</DefaultValue>
    <Description>Values Overflow</Description>
    <Tooltip>The behavior to apply when the text of value labels does not fit within the bounds of its corresponding visual element.</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>565</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="Hide">hide</Value>
    <Value display="Show">show</Value>
    <Value display="Trim">trim</Value>
  </Values>
</DesignerProperty>
