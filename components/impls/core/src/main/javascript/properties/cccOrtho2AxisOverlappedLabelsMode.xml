<DesignerProperty>
  <Header>
    <Name>cccOrtho2AxisOverlappedLabelsMode</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>hide</DefaultValue>
    <Description>ortho2AxisOverlappedLabelsMode</Description>
    <Tooltip>Controls how labels are laid out when they overlap (does not apply to discrete-hierarchical axes).</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>374</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="Hide">hide</Value>
    <Value display="Leave">leave</Value>
  </Values>
</DesignerProperty>
