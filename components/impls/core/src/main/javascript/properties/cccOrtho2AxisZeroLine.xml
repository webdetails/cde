<DesignerProperty>
  <Header>
    <Name>cccOrtho2AxisZeroLine</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>true</DefaultValue>
    <Description>Ortho 2 Axis Zero Line</Description>
    <Tooltip>Indicates if the zero line rule is drawn, on the position of the 0-valued tick, when there is one (applies to continuous-numeric axes).</Tooltip>
    <InputType>Boolean</InputType>
    <OutputType>Boolean</OutputType>
    <Order>401</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
</DesignerProperty>
