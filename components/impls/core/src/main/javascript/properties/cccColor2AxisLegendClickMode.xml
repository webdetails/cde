<DesignerProperty>
  <Header>
    <Name>cccColor2AxisLegendClickMode</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>toggleVisible</DefaultValue>
    <Description>Color 2 Axis Legend Click Mode</Description>
    <Tooltip>What happens when the user clicks a legend item (applies to color axes of discrete domain).</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>276</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="None">none</Value>
    <Value display="ToggleSelected">toggleSelected</Value>
    <Value display="ToggleVisible">toggleVisible</Value>
  </Values>
</DesignerProperty>
