<DesignerProperty>
  <Header>
    <Name>cccPlot2Stacked</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>false</DefaultValue>
    <Description>Plot 2 Stacked</Description>
    <Tooltip>Indicates that visual elements having identical category, but different series, are displayed on top of each other, along the plot's orthogonal direction, instead of side-by-side, along the base direction.</Tooltip>
    <InputType>Boolean</InputType>
    <OutputType>Boolean</OutputType>
    <Order>466</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
</DesignerProperty>
