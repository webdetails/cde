<DesignerProperty>
  <Header>
    <Name>cccColorScaleType</Name>
    <Parent>BaseProperty</Parent>
    <DefaultValue>linear</DefaultValue>
    <Description>Color Scale Type</Description>
    <Tooltip>The type of scale to use, in what concerns the range of the scale (applies to numeric domain axes).</Tooltip>
    <InputType type="valuelist"/>
    <OutputType>String</OutputType>
    <Order>292</Order>
    <Advanced>true</Advanced>
    <Version>2.0</Version>
  </Header>
  <Values>
    <Value display="Discrete">discrete</Value>
    <Value display="Linear">linear</Value>
    <Value display="Normal">normal</Value>
  </Values>
</DesignerProperty>
